# The public address of the status page (DNS A/AAAA record must point at this machine).
STATUS_DOMAIN=status.example.com
STATUS_TITLE=Example Open edX status
STATUS_FAIL_THRESHOLD=3
# Optional, defaults shown:
# STATUS_RETENTION_DAYS=90
# STATUS_HTTP_PORT=80
# STATUS_HTTPS_PORT=443
# Address the proxy ports bind to; use 127.0.0.1 for local tests.
# STATUS_BIND=0.0.0.0
# Image versions to pull (default: latest):
# STATUS_API_VERSION=latest
# STATUS_WEB_VERSION=latest
# For a quick local try-out without TLS: STATUS_DOMAIN=:80  STATUS_BIND=127.0.0.1  STATUS_HTTP_PORT=8088
# Secrets for `<name>_env` options in checks.yml (placeholders only, set real values in .env):
# STATUS_MYSQL_PASSWORD=change-me
# STATUS_REDIS_PASSWORD=change-me
